FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY requirements.txt requirements-api.txt ./
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -f /run/secrets/build_ca ]; then PIP_CERT=/run/secrets/build_ca pip install --no-cache-dir -r requirements-api.txt; else pip install --no-cache-dir -r requirements-api.txt; fi
COPY --chown=10001:10001 . .
USER 10001:10001
CMD ["sh", "-c", "exec python -m uvicorn src.experiment_api:app --host 0.0.0.0 --port ${PORT:-8080}"]
